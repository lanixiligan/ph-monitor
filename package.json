{
  "name": "ph-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Philippines real-time risk dashboard",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "migrate": "npm run migrate --workspace server",
    "load-provinces": "npm run load-provinces --workspace server",
    "load-places": "npm run load-places --workspace server",
    "ingest:earthquakes": "npm run ingest:earthquakes --workspace server",
    "ingest:weather": "npm run ingest:weather --workspace server",
    "compute:scores": "npm run compute:scores --workspace server",
    "ingest:events": "npm run ingest:events --workspace server",
    "ingest:storms": "npm run ingest:storms --workspace server",
    "sample-storm": "npm run sample-storm --workspace server",
    "ingest:forecast": "npm run ingest:forecast --workspace server",
    "ingest:news": "npm run ingest:news --workspace server",
    "ingest:alerts": "npm run ingest:alerts --workspace server",
    "weather-points": "npm run weather-points --workspace server",
    "check:sources": "npm run check:sources --workspace server",
    "replay": "npm run replay --workspace server",
    "test": "npm test --workspaces --if-present",
    "test:db": "npm run test:db --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
