{
  "name": "ph-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Philippines real-time risk dashboard",
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "migrate": "npm run migrate --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
