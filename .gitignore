# Installed packages (recreated by `npm install`)
node_modules/

# Local settings and secrets: never commit these
.env
.env.*
!.env.example

# Build output
dist/

# Downloaded boundary files (recreated by `npm run load-provinces`)
data/

# Claude Code's local files (settings, temporary worktrees)
.claude/

# Editor and OS clutter
.DS_Store
*.log
