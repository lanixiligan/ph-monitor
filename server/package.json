{
  "name": "@ph-monitor/server",
  "private": true,
  "version": "0.1.0",
  "description": "Backend: fetches feeds, computes scores, serves the API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "load-provinces": "tsx scripts/load-provinces.ts",
    "load-places": "tsx scripts/load-places.ts",
    "ingest:earthquakes": "tsx scripts/run-job.ts earthquakes",
    "ingest:weather": "tsx scripts/run-job.ts weather",
    "compute:scores": "tsx scripts/run-job.ts scores",
    "ingest:events": "tsx scripts/run-job.ts events",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
