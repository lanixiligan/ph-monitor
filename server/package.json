{
  "name": "@ph-monitor/server",
  "private": true,
  "version": "0.1.0",
  "description": "Backend: fetches feeds, computes scores, serves the API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "load-provinces": "tsx scripts/load-provinces.ts",
    "load-places": "tsx scripts/load-places.ts",
    "load-hazards": "tsx scripts/load-hazards.ts",
    "ingest:earthquakes": "tsx scripts/run-job.ts earthquakes",
    "ingest:weather": "tsx scripts/run-job.ts weather",
    "compute:scores": "tsx scripts/run-job.ts scores",
    "ingest:events": "tsx scripts/run-job.ts events",
    "ingest:storms": "tsx scripts/run-job.ts storms",
    "sample-storm": "tsx scripts/load-sample-storm.ts",
    "ingest:forecast": "tsx scripts/run-job.ts forecast",
    "ingest:news": "tsx scripts/run-job.ts news",
    "ingest:alerts": "tsx scripts/run-job.ts alerts",
    "ingest:heatmap": "tsx scripts/run-job.ts heatmap",
    "weather-points": "tsx scripts/pick-weather-points.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "measure:news": "tsx scripts/measure-news.ts",
    "replay": "tsx scripts/replay.ts",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 test/db/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/shapefile": "^0.6.4",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "shapefile": "^0.6.6",
    "zod": "^4.6.7"
  }
}
