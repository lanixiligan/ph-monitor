# Copy this file to `.env` and adjust if needed.
# `.env` is git-ignored, so real values never end up in the repository.
# Only the backend reads this file. The frontend never sees it.

# --- Database (used by docker-compose.yml and by the server) ---
POSTGRES_USER=phmonitor
POSTGRES_PASSWORD=change_me
POSTGRES_DB=phmonitor
# 5433 instead of the usual 5432, so it doesn't clash with a local PostgreSQL.
DB_PORT=5433

# Must match the four values above.
DATABASE_URL=postgres://phmonitor:change_me@localhost:5433/phmonitor

# --- Server ---
SERVER_PORT=3001

# --- Optional ---
# A free YouTube Data API key (leave empty to go without). With it, the link
# checker can tell which streams are live right now (about 1,200 of the 10,000
# free quota units a day). Without it, streams show their latest video and
# "may be offline". The key is only ever used by the server.
YOUTUBE_API_KEY=
